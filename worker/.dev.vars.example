# Local secrets for `npm run dev` (copy to .dev.vars — gitignored).
# Service account JSON on ONE line (Firebase console → Project settings → Service accounts → Generate new private key)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"paypilot-afc59","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}
# 32 random bytes, base64:  openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=
OPENROUTER_API_KEY=
EMAILJS_PRIVATE_KEY=
B2_KEY_ID=
B2_APPLICATION_KEY=
APP_BASE_URL=http://localhost:5320
# Uncomment to run against local Firebase emulators instead of the real project:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
