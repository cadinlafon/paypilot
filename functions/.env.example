# Non-secret Cloud Functions params (functions/.env). Secrets are set with
#   firebase functions:secrets:set NAME
# and are listed at the bottom of this file for reference only.

# Public base URL of the deployed web app (used for PayPal return URLs).
APP_BASE_URL=https://your-project.web.app
# Default OpenRouter model when an organization hasn't picked one.
OPENROUTER_DEFAULT_MODEL=nvidia/nemotron-3.5-super-vl:free
# Comma-separated allowlist of models organizations may choose.
OPENROUTER_ALLOWED_MODELS=nvidia/nemotron-3.5-super-vl:free,nvidia/nemotron-3.5-lightning:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free
# EmailJS service + template IDs (public identifiers, not secrets).
EMAILJS_SERVICE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_TEMPLATE_INVOICE=
EMAILJS_TEMPLATE_REMINDER=
EMAILJS_TEMPLATE_CUSTOMER=
EMAILJS_TEMPLATE_BUSINESS=
EMAILJS_TEMPLATE_AUTOMATION=
# Backblaze B2 private bucket
B2_BUCKET_ID=
B2_BUCKET_NAME=
# Exchange-rate provider: "frankfurter" (free, ECB, historical) is built in.
FX_PROVIDER=frankfurter
# Max upload size in bytes (default 8 MB)
MAX_UPLOAD_BYTES=8388608

# ── Secrets (set via `firebase functions:secrets:set`) ──
# OPENROUTER_API_KEY
# EMAILJS_PRIVATE_KEY
# B2_KEY_ID
# B2_APPLICATION_KEY
# CREDENTIALS_ENCRYPTION_KEY   (32 random bytes, base64 — encrypts per-org PayPal credentials at rest)
