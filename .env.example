# ─── Frontend (public — these values ship to the browser) ─────────────────────
# Firebase web config. Leave blank to run PayPilot in local Demo-only mode
# (no sign-in, no Real Mode). Firebase web config is not secret; security
# comes from Auth + Firestore rules + Cloud Functions checks.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Region your Cloud Functions are deployed to.
VITE_FUNCTIONS_REGION=us-central1
# Set to "true" to talk to the local Firebase emulators.
VITE_USE_EMULATORS=false

# NOTE: PayPal, OpenRouter, EmailJS private key, Backblaze B2 and the
# credential-encryption key are NEVER configured here. They live in
# Cloud Functions secrets — see functions/.env.example and README.md.

# Server functions backend: "worker" (Cloudflare, free — default) or "firebase" (Cloud Functions, needs Blaze).
VITE_BACKEND=worker
# Leave empty when the Worker serves the app (same origin). Set only if the API is on another domain.
VITE_API_BASE_URL=
